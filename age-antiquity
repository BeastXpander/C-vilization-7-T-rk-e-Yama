    <Replace Tag="LOC_LEADER_CHAIN_1000B_NAME" Language="fr_FR">
        <Text>Bıçakları.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1000C_NAME" Language="fr_FR">
        <Text>Paraları.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1000D_NAME" Language="fr_FR">
        <Text>Akılları.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1001B_NAME" Language="fr_FR">
        <Text>Bu güç demircilerin bıçaklarında bir amaç bulur.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1001C_NAME" Language="fr_FR">
        <Text>Demirciler bu gücü güzellik eserlerine kanalize ederler.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1002B_NAME" Language="fr_FR">
        <Text>Kervanlar bu cömertliği çiftliklerden pazarlara taşıyacak.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1002C_NAME" Language="fr_FR">
        <Text>Hasat, tahıl ambarının çok ötesinde bir nimet verir.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1010B_NAME" Language="fr_FR">
        <Text>O devaraja, yani tanrıların avatarı olacak.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1010C_NAME" Language="fr_FR">
        <Text>O bir bodhisattva, aydınlanmış biri olacak.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1011B_NAME" Language="fr_FR">
        <Text>Kutsal su ilahi ikonları süsler.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1011C_NAME" Language="fr_FR">
        <Text>Ashoka'nın kendisi daha da sertleşti.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1012B_NAME" Language="fr_FR">
        <Text>Toprak, büyüklük için organize edilmelidir.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1012C_NAME" Language="fr_FR">
        <Text>Dünyayı ele geçirmenin zamanı geldi.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1020B_NAME" Language="fr_FR">
        <Text>Senatörü dinleyin.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1020C_NAME" Language="fr_FR">
        <Text>Sadece ordunun gücü ve sadakati önemlidir.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1020D_NAME" Language="fr_FR">
        <Text>Hayatta siyasetten daha büyük zevkler vardır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1021B_NAME" Language="fr_FR">
        <Text>Usta zanaatkarlar.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1021C_NAME" Language="fr_FR">
        <Text>Yeni askerler.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1022B_NAME" Language="fr_FR">
        <Text>Augustus gerçekten de Sol Invictus'tur, geri dönmüştür.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1022C_NAME" Language="fr_FR">
        <Text>Bu yeni tapınakları da diğerleri gibi vergilendirin.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1030B_NAME" Language="fr_FR">
        <Text>Doğayı ve kullanımlarını tartışan eserler.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1030C_NAME" Language="fr_FR">
        <Text>İleri görüşlü düşünürlerin büyük konuşmalarının eserleri.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1030D_NAME" Language="fr_FR">
        <Text>Bağışçıların eserleri.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1031B_NAME" Language="fr_FR">
        <Text>Bu keşifler yerel mucitlere ilham veriyor.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1031C_NAME" Language="fr_FR">
        <Text>Bu sunum yerel halk için bir eğlencedir.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1032B_NAME" Language="fr_FR">
        <Text>...pazar çeyreğinde.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1032C_NAME" Language="fr_FR">
        <Text>...villalarda.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1040B_NAME" Language="fr_FR">
        <Text>Bu arıtma kavramlarını takip edin.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1040C_NAME" Language="fr_FR">
        <Text>Geleneksel masalları kucaklayın.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1040D_NAME" Language="fr_FR">
        <Text>Estetik önemli değil.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1041B_NAME" Language="fr_FR">
        <Text>Drama ve ihtişam herkese ilham verecek.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1041C_NAME" Language="fr_FR">
        <Text>İşlev ve konfor temel unsurlardır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1042B_NAME" Language="fr_FR">
        <Text>Keşif hikayeleri herkese ilham verir.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1042C_NAME" Language="fr_FR">
        <Text>Savaş hikayeleri en popüler olanlarıdır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1050B_NAME" Language="fr_FR">
        <Text>Ordu öncelikli olmalıdır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1050C_NAME" Language="fr_FR">
        <Text>Çok zaman almayacaksa.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1050D_NAME" Language="fr_FR">
        <Text>Bu gösteriş için ayrılan fonlar başka yerlerde harcansa daha iyi olur.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1051B_NAME" Language="fr_FR">
        <Text>En etkili diplomasi kılıçla yapılır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1051C_NAME" Language="fr_FR">
        <Text>Sözcüklerin daha uzun süreli bir etkisi vardır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1052B_NAME" Language="fr_FR">
        <Text>Kılık değiştirmiş bir kral, halkından çok şey öğrenebilir.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1052C_NAME" Language="fr_FR">
        <Text>Bu maskaralık sadece eğlence için.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1060B_NAME" Language="fr_FR">
        <Text>Böyle bir şefkat dünya ile paylaşılmalıdır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1060C_NAME" Language="fr_FR">
        <Text>Bu fikirler daha derin düşünmeyi hak ediyor.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1060D_NAME" Language="fr_FR">
        <Text>İyilik kazanılmalıdır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1061B_NAME" Language="fr_FR">
        <Text>Nazik bir el kalıcı dostlar yaratır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1061C_NAME" Language="fr_FR">
        <Text>Biraz altın kazanma zamanı.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1062B_NAME" Language="fr_FR">
        <Text>Eğitim özgürlüktür.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1062C_NAME" Language="fr_FR">
        <Text>Kodeksler korunmalıdır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1070B_NAME" Language="fr_FR">
        <Text>Savaş en gerçek sanattır.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1070C_NAME" Language="fr_FR">
        <Text>Kılıç kötü müzik yapıyor!</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1070D_NAME" Language="fr_FR">
        <Text>İkisi de ekonomik meselelerdir.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1071B_NAME" Language="fr_FR">
        <Text>Bir savaşı kazanmak böyle bir şey olmalı.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1071C_NAME" Language="fr_FR">
        <Text>Bu akustik konusunda yapılacak bir şey yok mu?</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1072B_NAME" Language="fr_FR">
        <Text>Öğrenmek zorundalar.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1072C_NAME" Language="fr_FR">
        <Text>Mızrak kullanıyorlar, kalem değil.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1080B_NAME" Language="fr_FR">
        <Text>"Birlikte daha güçlüyüz."</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1080C_NAME" Language="fr_FR">
        <Text>"Onları bulana kadar durmayacağız."</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1080D_NAME" Language="fr_FR">
        <Text>"Bu anı yaşa ve nefes al."</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1081B_NAME" Language="fr_FR">
        <Text>Açık konuşma bu gerilimleri azaltacaktır.</Text>
