    <Replace Tag="LOC_LEADER_CHAIN_1032A_STORYTITLE" Language="fr_FR">
        <Text>Hatip Franklin</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1032B_COMPLETION" Language="fr_FR">
        <Text>Franklin'in pazarları dünyanın dört bir yanından gelen mallar ve hikâyelerle dolup taşıyor ve halkını hem kese hem de zihin olarak zenginleştiriyor.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1032B_DESCRIPTION" Language="fr_FR">
