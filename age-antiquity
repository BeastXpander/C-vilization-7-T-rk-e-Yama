        <Text>{1_reward}.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1052B_IMPERATIVE" Language="fr_FR">
        <Text>2 Pazar var.</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_CHAIN_1052B_STORYTITLE" Language="fr_FR">
        <Text>Hasadın Efendisi</Text>
