    <Replace Tag="LOC_PEDIA_AGES_TITLE" Language="fr_FR">
        <Text>Çağlar</Text>
    </Replace>
    <Replace Tag="LOC_PEDIA_ARMY_TITLE" Language="fr_FR">
        <Text>Ordu Yönetimi</Text>
    </Replace>
    <Replace Tag="LOC_PEDIA_BUILDINGS_TITLE" Language="fr_FR">
