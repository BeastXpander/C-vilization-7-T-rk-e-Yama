    <Replace Tag="LOC_ATTRIBUTE_QUEST_1014A_COMPLETION" Language="fr_FR">
        <Text>İnsanlar birbirlerine bakar ve sorarlar: Biz kimiz? Kültürel mirasları derinleşiyor.</Text>
    </Replace>
    <Replace Tag="LOC_ATTRIBUTE_QUEST_1014A_DESCRIPTION" Language="fr_FR">
        <Text>{1_reward}.</Text>
    </Replace>
    <Replace Tag="LOC_ATTRIBUTE_QUEST_1014A_STORYTITLE" Language="fr_FR">
        <Text>Kültürel Nitelik</Text>
    </Replace>
    <Replace Tag="LOC_ATTRIBUTE_QUEST_1015A_COMPLETION" Language="fr_FR">
        <Text>Keşiflerle ilerleme devam ediyor. İnsanların dünyanın işleyişini öğrenme arzusu bastırılamıyor.</Text>
    </Replace>
    <Replace Tag="LOC_ATTRIBUTE_QUEST_1015A_DESCRIPTION" Language="fr_FR">
        <Text>{1_reward}.</Text>
