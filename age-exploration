    <Replace Tag="LOC_259B_NAME" Language="fr_FR">
        <Text>Ne güçlü bir gemi!</Text>
    </Replace>
    <Replace Tag="LOC_259C_DESCRIPTION" Language="fr_FR">
        <Text>{1_reward}.</Text>
    </Replace>
    <Replace Tag="LOC_259C_NAME" Language="fr_FR">
        <Text>Görmüş olması gereken yerler...</Text>
